# PostgreSQL. Эти же значения подставляются в DATABASE_URL сервиса api
# и в healthcheck базы, поэтому менять их нужно только здесь.
POSTGRES_USER=bookshelf
POSTGRES_PASSWORD=bookshelf
POSTGRES_DB=bookshelf

# Для локальной разработки без Docker. В контейнере DATABASE_URL
# переопределяется в docker-compose.yml: там хост не localhost, а имя сервиса.
DATABASE_URL=postgresql+asyncpg://bookshelf:bookshelf@localhost:5432/bookshelf

# Бизнес-правила
RESERVATION_HOURS=48
LOAN_DAYS=14
MAX_ACTIVE_RESERVATIONS=3
FINE_PER_DAY=50.00
FINE_LOST=1500.00
SUBSCRIPTION_PRICE=299.00
SUBSCRIPTION_DAYS=30

# JWT. Секрет не короче 32 символов, значения по умолчанию нет:
# сгенерировать своё, например python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-unique-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
