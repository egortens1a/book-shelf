{
  "info": {
    "name": "BookShelf — блок Б",
    "description": "Подписки, экземпляры, бронирование, штрафы, чтение, список желаний и статистика.\n\nПеред запуском: поднять базу и накатить тестовые данные (python -m app.scripts.seed), затем запустить API (python -m app.main).\n\nПапки идут в порядке сценария: сначала вход всеми тремя ролями, дальше подписка, экземпляр, бронь, выдача, возврат. Идентификаторы созданных объектов тесты сохраняют в переменные коллекции сами.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "password", "value": "seed-password" },
    { "key": "readerEmail", "value": "anna@loans.seed" },
    { "key": "librarianEmail", "value": "maria@loans.seed" },
    { "key": "adminEmail", "value": "admin@catalog.seed" },
    { "key": "readerToken", "value": "" },
    { "key": "librarianToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "bookId", "value": "1" },
    { "key": "genreId", "value": "1" },
    { "key": "copyId", "value": "" },
    { "key": "reservationId", "value": "" },
    { "key": "fineId", "value": "" },
    { "key": "inventoryNumber", "value": "INV-9001" }
  ],
  "item": [
    {
      "name": "1. Вход",
      "item": [
        {
          "name": "Читатель",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.collectionVariables.set('readerToken', t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{readerEmail}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] },
            "description": "OAuth2 password flow: форма, а не JSON. Токен сохраняется в readerToken."
          }
        },
        {
          "name": "Библиотекарь",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('librarianToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{librarianEmail}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        },
        {
          "name": "Администратор",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{adminEmail}}" },
                { "key": "password", "value": "{{password}}" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/login", "host": ["{{baseUrl}}"], "path": ["login"] }
          }
        }
      ]
    },
    {
      "name": "2. Подписка",
      "item": [
        {
          "name": "Оформить подписку",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/subscription", "host": ["{{baseUrl}}"], "path": ["me", "subscription"] },
            "description": "Тела нет: цена и срок берутся из настроек. Повторный вызов при действующей подписке ставит продление в очередь (PENDING), третий даёт 409."
          }
        },
        {
          "name": "Текущее состояние",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/subscription", "host": ["{{baseUrl}}"], "path": ["me", "subscription"] },
            "description": "Действующая подписка, отложенная и флаг доступа. Доступ считается по датам, а не по статусу."
          }
        },
        {
          "name": "История подписок",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/subscriptions", "host": ["{{baseUrl}}"], "path": ["me", "subscriptions"] }
          }
        }
      ]
    },
    {
      "name": "3. Экземпляры (библиотекарь)",
      "item": [
        {
          "name": "Добавить экземпляр",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('copyId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"inventory_number\": \"{{inventoryNumber}}\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/copies",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "copies"]
            },
            "description": "Инвентарный номер уникален: повторный номер даёт 409, а не ошибку базы."
          }
        },
        {
          "name": "Экземпляры книги",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/copies",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "copies"]
            }
          }
        },
        {
          "name": "Списать экземпляр",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/copies/{{copyId}}/write-off",
              "host": ["{{baseUrl}}"],
              "path": ["copies", "{{copyId}}", "write-off"]
            },
            "description": "Списать можно только свободный экземпляр. Забронированный или выданный даёт 409."
          }
        }
      ]
    },
    {
      "name": "4. Бронирование (читатель)",
      "item": [
        {
          "name": "Забронировать книгу",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('reservationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"book_id\": {{bookId}}\n}" },
            "url": { "raw": "{{baseUrl}}/me/reservations", "host": ["{{baseUrl}}"], "path": ["me", "reservations"] },
            "description": "Нужна действующая подписка, отсутствие просрочек и неоплаченных штрафов, лимит одновременных броней. Свободный экземпляр выбирается под блокировкой."
          }
        },
        {
          "name": "Мои брони",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/reservations", "host": ["{{baseUrl}}"], "path": ["me", "reservations"] },
            "description": "В карточке есть название книги, инвентарный номер и расчётная пеня, если срок уже вышел."
          }
        },
        {
          "name": "Отменить бронь",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/reservations/{{reservationId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["me", "reservations", "{{reservationId}}", "cancel"]
            },
            "description": "Отменить можно только бронь в статусе CREATED. Чужая бронь даёт 404, а не 403."
          }
        }
      ]
    },
    {
      "name": "5. Выдача и возврат (библиотекарь)",
      "item": [
        {
          "name": "Список броней",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/reservations?status=CREATED&limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "reservations"],
              "query": [
                { "key": "status", "value": "CREATED" },
                { "key": "user_id", "value": "", "disabled": true },
                { "key": "inventory_number", "value": "", "disabled": true },
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Выдать книгу",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/reservations/{{reservationId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "reservations", "{{reservationId}}", "issue"]
            },
            "description": "Если срок получения истёк, бронь закрывается, экземпляр возвращается на полку, ответ 409."
          }
        },
        {
          "name": "Принять возврат",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/reservations/{{reservationId}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "reservations", "{{reservationId}}", "return"]
            },
            "description": "При просрочке в ответе появляется начисленный штраф, иначе поле fine равно null."
          }
        },
        {
          "name": "Отметить утерю",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/reservations/{{reservationId}}/lost",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "reservations", "{{reservationId}}", "lost"]
            },
            "description": "Фиксированный штраф за утерю. Экземпляр переходит в LOST и из оборота выбывает."
          }
        }
      ]
    },
    {
      "name": "6. Штрафы",
      "item": [
        {
          "name": "Мои штрафы",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const items = pm.response.json().items;",
                  "if (items.length) pm.collectionVariables.set('fineId', items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/fines", "host": ["{{baseUrl}}"], "path": ["me", "fines"] },
            "description": "История штрафов и сумма неоплаченных одним ответом."
          }
        },
        {
          "name": "Отметить оплату",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{librarianToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/fines/{{fineId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "fines", "{{fineId}}", "pay"]
            },
            "description": "Идемпотентно: повторная оплата возвращает тот же штраф, а не ошибку."
          }
        }
      ]
    },
    {
      "name": "7. Чтение",
      "item": [
        {
          "name": "Открыть книгу",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "read"]
            },
            "description": "Текст и позиция, с которой читатель продолжит. Для книги с доступом SUBSCRIPTION нужна действующая подписка, иначе 403."
          }
        },
        {
          "name": "Прогресс чтения",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "progress"]
            }
          }
        },
        {
          "name": "Сохранить позицию",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"position\": 10\n}" },
            "url": {
              "raw": "{{baseUrl}}/books/{{bookId}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{bookId}}", "progress"]
            },
            "description": "PUT, потому что операция идемпотентна. Позиция за пределами текста даёт 422. Дойдя до конца, книга помечается прочитанной — и её можно оценить."
          }
        }
      ]
    },
    {
      "name": "8. Список «хочу прочитать»",
      "item": [
        {
          "name": "Мой список",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/wishlist", "host": ["{{baseUrl}}"], "path": ["me", "wishlist"] },
            "description": "Книги с авторами и жанрами, недавно добавленные сверху."
          }
        },
        {
          "name": "Добавить книгу",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/wishlist/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["me", "wishlist", "{{bookId}}"]
            },
            "description": "PUT, а не POST: повторное добавление не ошибка и список не меняет. Неопубликованная книга даёт 404."
          }
        },
        {
          "name": "Убрать книгу",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/wishlist/{{bookId}}",
              "host": ["{{baseUrl}}"],
              "path": ["me", "wishlist", "{{bookId}}"]
            },
            "description": "Тоже идемпотентно: удаление отсутствующей книги не ошибка."
          }
        }
      ]
    },
    {
      "name": "9. Статистика (администратор)",
      "item": [
        {
          "name": "Сводка",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] },
            "description": "Каталог, пользователи, брони, подписки и штрафы. Читателю прилетит 403."
          }
        },
        {
          "name": "Рейтинг книг жанра",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/stats/top?genre_id={{genreId}}&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "stats", "top"],
              "query": [
                { "key": "genre_id", "value": "{{genreId}}" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Только опубликованные книги с оценками. limit ограничен 1..50, иначе 422."
          }
        }
      ]
    },
    {
      "name": "10. Проверка отказов",
      "item": [
        {
          "name": "Без токена — 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/me/reservations", "host": ["{{baseUrl}}"], "path": ["me", "reservations"] }
          }
        },
        {
          "name": "Читатель в админку — 403",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/stats", "host": ["{{baseUrl}}"], "path": ["admin", "stats"] }
          }
        },
        {
          "name": "Читатель выдаёт книгу — 403",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/librarian/reservations/{{reservationId}}/issue",
              "host": ["{{baseUrl}}"],
              "path": ["librarian", "reservations", "{{reservationId}}", "issue"]
            }
          }
        },
        {
          "name": "Несуществующая книга — 404",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{readerToken}}" }] },
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/wishlist/999999",
              "host": ["{{baseUrl}}"],
              "path": ["me", "wishlist", "999999"]
            }
          }
        }
      ]
    }
  ]
}
