{
  "info": {
    "name": "BookShelf — блок Б",
    "description": "Подписки, экземпляры, бронирование, штрафы, чтение, список желаний и статистика.\n\nПеред запуском: поднять базу и накатить тестовые данные (python -m app.scripts.seed), затем запустить API (python -m app.main).\n\nПапки идут в порядке сценария: сначала вход всеми тремя ролями, дальше подписка, экземпляр, бронь, выдача, возврат. Идентификаторы созданных объектов тесты сохраняют в переменные коллекции сами.\n\nОкружение: выберите «Bookshelf local». Все переменные (учётные записи, токены, id созданных объектов) хранятся только в нём, в самих коллекциях переменных нет. Данные: python -m app.scripts.seed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Вход",
      "item": [
        {
          "name": "Читатель с подпиской",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.environment.set('subscriberToken', t);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{subscriberEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{subscriberPassword}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Пользователь с активной подпиской (anna@loans.seed, seed_loans). OAuth2 password flow: форма, а не JSON. Токен сохраняется в subscriberToken.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Библиотекарь",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.environment.set('librarianToken', pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{librarianEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{librarianPassword}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Администратор",
          "event": [
            {
              "listen": "test",
