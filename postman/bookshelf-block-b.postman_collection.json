    {
      "name": "11. Отмена брони и списание экземпляра",
      "description": "Вынесено в конец, чтобы не ломать основной сценарий: отмена возможна только до выдачи, а списание убирает экземпляр из выдачи. Для отмены бронируется книга ещё раз.",
      "item": [
        {
          "name": "Забронировать книгу (для отмены)",
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "key": "token",
                "value": "{{subscriberToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.environment.set('reservationId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book_id\": {{loanBookId}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/me/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "me",
                "reservations"
              ]
            },
            "description": "Нужна действующая подписка, отсутствие просрочек и неоплаченных штрафов, лимит одновременных броней. Свободный экземпляр выбирается под блокировкой.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{subscriberToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Отменить бронь",
